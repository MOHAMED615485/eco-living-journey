---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).filter((post: any) => post.data.title && post.data.heroImage);

const categories = {
  "Solar Generator Reviews": [
    "ecoflow-delta-3-plus-review",
    "jackery-explorer-1000-v2-review",
    "bluetti-ac200l-review",
    "ecoflow-vs-jackery-comparison",
    "ecoflow-vs-bluetti",
  ],
  "Best Solar Generators": [
    "best-solar-generator-home-backup-2026",
    "best-solar-generator-under-1000",
    "best-solar-generator-chest-freezer-2026",
    "best-solar-generator-well-pump",
    "best-solar-generator-cpap-machine",
    "best-solar-camping-2026",
    "best-solar-generator-camping-2026",
  ],
  "Power Outage Prep": [
    "how-to-prep-home-power-outage",
    "how-long-do-power-outages-last",
    "how-long-food-lasts-without-power",
    "best-emergency-kit-power-outage-2026",
    "chest-freezer-blackout-math",
  ],
  "Solar Generator Guides": [
    "surge-vs-running-watts",
    "what-appliances-can-solar-generator-run",
    "will-1000w-solar-generator-run-refrigerator",
    "can-solar-generator-power-window-ac",
    "how-long-does-solar-generator-last",
    "store-solar-generator-winter",
    "lifepo4-vs-lithium-ion",
    "portable-power-station-vs-gas-generator",
    "how-many-watts-chest-freezer",
    "what-is-lra-on-a-freezer",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={"Blog — Eco Living Journey"} description={"Real-world solar generator tests, home backup power guides, and emergency prep by Ethan Reynolds — 73-day field tester."} />
    <script is:inline data-grow-initializer="">!(function(){window.addEventListener('load',function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");(e.type="text/javascript"),(e.src="https://faves.grow.me/main.js"),(e.defer=!0),e.setAttribute("data-grow-faves-site-id","U2l0ZTo1ZmZlMDAzMS1jMTliLTRkNDktOWVlYy1jYTA1YWRmNjAyNTU=");var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);});})();</script>
  </head>
  <body style="margin:0;padding:0;background:#f5f0dc;font-family:Georgia,serif;">
    <Header />

    <div style="background:#2d6a4f;padding:2.5rem 1rem 2rem;text-align:center;">
      <h1 style="color:#fff;font-size:2rem;font-weight:800;margin:0 0 0.4rem;font-family:Georgia,serif;">Solar Generator & Power Outage Guides</h1>
      <p style="color:rgba(255,255,255,0.75);font-size:0.95rem;margin:0 0 1.5rem;">73-day real-world tests by Ethan Reynolds — no sponsored fluff, just honest results</p>
      <div style="max-width:520px;margin:0 auto;position:relative;">
        <input type="text" id="searchInput" placeholder="Search articles... (e.g. EcoFlow, freezer, outage)" autocomplete="off"
          style="width:100%;padding:13px 48px 13px 20px;border-radius:50px;border:none;font-size:0.95rem;outline:none;background:#fff;color:#1a202c;box-shadow:0 4px 20px rgba(0,0,0,0.15);font-family:Georgia,serif;box-sizing:border-box;" />
        <span style="position:absolute;right:18px;top:50%;transform:translateY(-50%);color:#2d6a4f;font-size:1.1rem;pointer-events:none;">&#128269;</span>
      </div>
    </div>

    <div style="max-width:1100px;margin:0 auto;padding:2.5rem 1.5rem 4rem;">

      <div id="noResults" style="display:none;text-align:center;padding:3rem;color:#718096;font-size:1.1rem;">No articles found. Try a different search term.</div>

      <div id="searchResultsSection" style="display:none;margin-bottom:3rem;">
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;padding-bottom:0.75rem;border-bottom:2px solid #3d8b6f;">
          <h2 style="font-size:1.1rem;font-weight:800;color:#3d8b6f;margin:0;text-transform:uppercase;letter-spacing:0.05em;">Search Results</h2>
          <span id="searchCount" style="background:#3d8b6f;color:#fff;font-size:0.72rem;font-weight:700;padding:2px 10px;border-radius:50px;">0</span>
        </div>
        <div id="searchGrid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;"></div>
      </div>

      {Object.entries(categories).map(([catName, slugs]) => {
        const catPosts = slugs
          .map(slug => allPosts.find((p: any) => (p.slug || p.id) === slug))
          .filter(Boolean);
        if (catPosts.length === 0) return null;
        return (
          <div class="cat-section" style="margin-bottom:3rem;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;padding-bottom:0.6rem;border-bottom:2px solid #2d6a4f;">
              <h2 style="font-size:1.05rem;font-weight:800;color:#2d6a4f;margin:0;text-transform:uppercase;letter-spacing:0.06em;">{catName}</h2>
              <span style="background:#2d6a4f;color:#fff;font-size:0.7rem;font-weight:700;padding:2px 9px;border-radius:50px;">{catPosts.length}</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;">
              {catPosts.map((post: any) => (
                <a
                  class="blog-card"
                  href={"/blog/" + (post.slug || post.id) + "/"}
                  data-title={(post.data.title || "").toLowerCase()}
                  data-cat={catName.toLowerCase()}
                  style="background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 2px 10px rgba(45,106,79,0.08);text-decoration:none;display:block;transition:transform 0.2s,box-shadow 0.2s;"
                  onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 28px rgba(45,106,79,0.18)'"
                  onmouseout="this.style.transform='';this.style.boxShadow='0 2px 10px rgba(45,106,79,0.08)'"
                >
                  <img
                    src={post.data.heroImage?.src || post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                    style="width:100%;height:150px;object-fit:cover;display:block;"
                  />
                  <div style="padding:0.85rem 1rem 1rem;">
                    <p style="font-size:0.88rem;font-weight:700;color:#1a202c;line-height:1.4;margin:0 0 0.4rem;font-family:Georgia,serif;">{post.data.title}</p>
                    <p style="font-size:0.75rem;color:#718096;margin:0;font-family:Georgia,serif;"><FormattedDate date={post.data.pubDate} /></p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <Footer />

    <script is:inline>
      var searchInput = document.getElementById('searchInput');
      var searchResultsSection = document.getElementById('searchResultsSection');
      var searchGrid = document.getElementById('searchGrid');
      var searchCount = document.getElementById('searchCount');
      var noResults = document.getElementById('noResults');
      var catSections = document.querySelectorAll('.cat-section');
      var allCards = document.querySelectorAll('.blog-card');

      searchInput.addEventListener('input', function() {
        var q = this.value.toLowerCase().trim();
        if (q === '') {
          searchResultsSection.style.display = 'none';
          noResults.style.display = 'none';
          catSections.forEach(function(s) { s.style.display = ''; });
          return;
        }
        catSections.forEach(function(s) { s.style.display = 'none'; });
        var matched = [];
        allCards.forEach(function(card) {
          var t = card.getAttribute('data-title') || '';
          var c = card.getAttribute('data-cat') || '';
          if (t.includes(q) || c.includes(q)) matched.push(card.cloneNode(true));
        });
        searchGrid.innerHTML = '';
        matched.forEach(function(card) { searchGrid.appendChild(card); });
        searchCount.textContent = matched.length;
        if (matched.length > 0) {
          searchResultsSection.style.display = 'block';
          noResults.style.display = 'none';
        } else {
          searchResultsSection.style.display = 'none';
          noResults.style.display = 'block';
        }
      });
    </script>
  </body>
</html>
