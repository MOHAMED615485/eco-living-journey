---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  robots?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = '/social-preview.webp', type = 'website', robots } = Astro.props;
---

<meta charset="utf-8" />
<script is:inline>
if (location.hostname.endsWith('.pages.dev')) {
  location.replace('https://ecoliving-journey.com' + location.pathname + location.search);
}
</script>
{robots && <meta name="robots" content={robots} />}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site).toString()}
/>
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL.toString()} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Eco Living Journey" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site).toString()} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="1600" />
<meta property="og:image:type" content="image/webp" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL.toString()} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site).toString()} />

<meta name="impact-site-verification" content="d8bc139f-6fa3-4f8b-b948-3d9bcfffbd54" />
<meta name="p:domain_verify" content="786a7fc7e131a98a228a0345831b4d91" />





<!-- Preconnect for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preload" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" /></noscript>
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://faves.grow.me" />
<link rel="dns-prefetch" href="https://f.convertkit.com" />
<link rel="dns-prefetch" href="https://app.grow.me" />
<link rel="dns-prefetch" href="https://scripts.clarity.ms" />
<link rel="dns-prefetch" href="https://www.clarity.ms" />

<!-- GA4 queue is initialized before page interaction; library download remains deferred until load. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
  window.gtag('js', new Date());
  window.gtag('config', 'G-R4DLNKRS96', { 'transport_type': 'beacon' });
  window.addEventListener('load', function() {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-R4DLNKRS96';
    document.head.appendChild(s);
  });
</script>

<!-- Affiliate click measurement: queues safely until GA4 is configured. No destination URLs are changed. -->
<script is:inline>
(function () {
  if (window.__ecoAffiliateTrackingInstalled) return;
  window.__ecoAffiliateTrackingInstalled = true;

  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () {
    window.dataLayer.push(arguments);
  };

  var awinAdvertisers = {
    '59183': 'jackery',
    '59271': 'bluetti',
    '124484': 'survivex'
  };
  var pendingEvents = [];

  function sendAffiliateEvent(params) {
    if (document.readyState === 'complete') {
      window.gtag('event', 'affiliate_click', params);
    } else {
      pendingEvents.push(params);
    }
  }

  window.addEventListener('load', function () {
    pendingEvents.forEach(function (params) {
      window.gtag('event', 'affiliate_click', params);
    });
    pendingEvents = [];
  });

  document.addEventListener('click', function (event) {
    var link = event.target && event.target.closest
      ? event.target.closest('a[href]')
      : null;
    if (!link) return;

    var url;
    try {
      url = new URL(link.href, window.location.href);
    } catch (error) {
      return;
    }

    var host = url.hostname.toLowerCase();
    var isAwin = host === 'awin1.com' || host.endsWith('.awin1.com');
    var isAmazon = /^www\.amazon\.(com|co\.uk|ca|de|fr|it|es|nl|se|pl|com\.au|co\.jp)$/i.test(host)
      && url.searchParams.has('tag');

    if (!isAwin && !isAmazon) return;

    var advertiserId = isAwin ? (url.searchParams.get('awinmid') || '') : '';
    var merchant = isAmazon ? 'amazon' : (awinAdvertisers[advertiserId] || 'awin');
    var placement = 'content';

    if (link.closest('.cta-container, .cta-button-amazon')) {
      placement = 'cta';
    } else if (link.closest('table')) {
      placement = 'table';
    } else if (link.closest('header')) {
      placement = 'header';
    } else if (link.closest('footer')) {
      placement = 'footer';
    }

    var product = link.getAttribute('data-product')
      || link.getAttribute('aria-label')
      || link.getAttribute('title')
      || (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100)
      || 'unspecified';

    sendAffiliateEvent({
      merchant: merchant,
      affiliate_network: isAmazon ? 'amazon_associates' : 'awin',
      advertiser_id: advertiserId || 'not_applicable',
      product: product,
      article_path: window.location.pathname,
      placement: placement,
      link_domain: host
    });
  }, true);
})();
</script>

<!-- Microsoft Clarity deferred -->
<script>
  window.addEventListener('load', function() {
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wf2f6vli35");
  });
</script>
