---
// PremiumLeadWidget.astro - Power Advisor v2
---

<div id="pw-container">
  <!-- Minimized bubble -->
  <button id="pw-bubble" style="display:none" onclick="pwRestore()">
    <span style="font-size:24px">⚡</span>
    <span style="font-size:10px;font-weight:700;line-height:1.2;text-align:center">Power<br>Advisor</span>
  </button>

  <!-- Main widget -->
  <div id="pw-main">
    <!-- Header -->
    <div id="pw-header">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:28px">⚡</span>
        <div>
          <div style="font-size:18px;font-weight:700;color:white">Power Advisor</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.85)">Find Your Perfect Solar Generator</div>
        </div>
      </div>
      <button id="pw-min-btn" onclick="pwMinimize()" title="Minimize">
        <svg width="18" height="18" viewBox="0 0 18 18"><path d="M2 9h14" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Trust bar -->
    <div id="pw-trust">
      <span>✓ Expert Tested</span>
      <span>⭐ 5/5 Reviews</span>
      <span>🔒 Private</span>
    </div>

    <!-- Body -->
    <div id="pw-body">

      <!-- STEP 1: Quiz -->
      <div id="pw-step-quiz">
        <div id="pw-progress-wrap">
          <div id="pw-progress-bar"></div>
        </div>
        <div id="pw-progress-label">Step 1 of 3</div>
        <div id="pw-question-box"></div>
      </div>

      <!-- STEP 2: Outcome + email capture -->
      <div id="pw-step-result" style="display:none">
        <div id="pw-recommendation-box"></div>

        <!-- Ask what they want to do -->
        <div id="pw-intent-box">
          <p style="font-weight:600;font-size:14px;color:#1a1a1a;margin:0 0 12px">What would you like to do?</p>
          <button class="pw-intent-btn" onclick="pwShowBuyNow()">🛒 Buy now — take me to the best price</button>
          <button class="pw-intent-btn" onclick="pwShowLearnMore()">📖 I want to read more first</button>
          <button class="pw-intent-btn" onclick="pwShowGuide()">📧 Send me a free buying guide</button>
        </div>

        <!-- Buy now CTA -->
        <div id="pw-buy-box" style="display:none">
          <a id="pw-buy-link" href="#" target="_blank" rel="noopener sponsored" class="pw-cta-btn">
            View Best Price on Amazon →
          </a>
          <p style="font-size:11px;color:#888;margin:8px 0 0;text-align:center">Opens in new tab • Affiliate link</p>
          <button class="pw-secondary-btn" onclick="pwShowIntent()">← Back</button>
        </div>

        <!-- Learn more CTA -->
        <div id="pw-learn-box" style="display:none">
          <a id="pw-article-link" href="#" class="pw-cta-btn">
            Read Full Review →
          </a>
          <button class="pw-secondary-btn" onclick="pwShowIntent()">← Back</button>
        </div>

        <!-- Email capture -->
        <div id="pw-email-box" style="display:none">
          <p style="font-size:13px;color:#555;margin:0 0 16px;text-align:center">Get a personalized buying guide sent to your inbox</p>
          <div class="pw-field">
            <label>Your Name</label>
            <input type="text" id="pw-name" placeholder="Enter your name">
            <span class="pw-err" id="pw-name-err"></span>
          </div>
          <div class="pw-field">
            <label>Email Address</label>
            <input type="email" id="pw-email" placeholder="your@email.com">
            <span class="pw-err" id="pw-email-err"></span>
          </div>
          <div style="background:#f0f7f3;padding:10px 12px;border-radius:8px;font-size:12px;color:#444;margin-bottom:16px">
            ✓ Personalized for your needs &nbsp;·&nbsp; ✓ No spam ever
          </div>
          <button onclick="pwSubmitEmail()" class="pw-submit-btn">Send My Free Guide ⚡</button>
          <button class="pw-secondary-btn" onclick="pwShowIntent()">← Back</button>
        </div>
      </div>

      <!-- STEP 3: Success -->
      <div id="pw-step-success" style="display:none;text-align:center;padding:20px 0">
        <div style="width:56px;height:56px;background:#10b981;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 16px">✓</div>
        <h3 style="margin:0 0 8px;font-size:17px;font-weight:700;color:#1a1a1a">Guide on its way!</h3>
        <p style="margin:0 0 4px;font-size:13px;color:#666">Check your inbox.</p>
        <p id="pw-success-product" style="font-weight:600;color:#2d6a4f;font-size:13px;margin:12px 0 0"></p>
        <button class="pw-secondary-btn" style="margin-top:16px" onclick="pwClose()">Close</button>
      </div>

    </div>
  </div>
</div>

<style>
  #pw-container { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; position: fixed; z-index: 2147483647; bottom: 0; right: 0; pointer-events: none; }
  #pw-container * { pointer-events: all; }

  /* Bubble */
  #pw-bubble {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 72px;
    height: 72px;
    background: linear-gradient(135deg, #2d6a4f, #3d8b6f);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    z-index: 2147483647;
    box-shadow: 0 4px 20px rgba(45,106,79,0.5);
    transition: transform 0.2s;
  }
  #pw-bubble:hover { transform: scale(1.08); }

  /* Main widget */
  #pw-main {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 400px;
    max-width: calc(100vw - 32px);
    background: white;
    border-radius: 16px;
    box-shadow: 0 12px 48px rgba(0,0,0,0.18);
    z-index: 2147483647;
    overflow: hidden;
    animation: pwSlideUp 0.35s ease;
    display: none;
  }

  @keyframes pwSlideUp {
    from { transform: translateY(80px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* Header */
  #pw-header {
    background: linear-gradient(135deg, #2d6a4f 0%, #3d8b6f 100%);
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #pw-min-btn {
    background: rgba(255,255,255,0.2);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  #pw-min-btn:hover { background: rgba(255,255,255,0.35); }

  /* Trust bar */
  #pw-trust {
    display: flex;
    gap: 14px;
    padding: 10px 20px;
    background: #f8f8f8;
    border-bottom: 1px solid #eee;
    font-size: 11px;
    font-weight: 600;
    color: #333;
  }

  /* Body */
  #pw-body {
    padding: 20px;
    max-height: 65vh;
    overflow-y: auto;
  }

  /* Progress */
  #pw-progress-wrap {
    height: 4px;
    background: #e5e7eb;
    border-radius: 2px;
    margin-bottom: 8px;
    overflow: hidden;
  }
  #pw-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #2d6a4f, #3d8b6f);
    width: 33%;
    transition: width 0.4s ease;
  }
  #pw-progress-label {
    font-size: 11px;
    color: #888;
    text-align: right;
    margin-bottom: 16px;
  }

  /* Question */
  .pw-question-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 6px;
  }
  .pw-question-hint {
    font-size: 12px;
    color: #777;
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .pw-opt {
    width: 100%;
    background: white;
    border: 2px solid #e5e7eb;
    color: #1a1a1a;
    padding: 12px 16px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 8px;
    text-align: left;
    transition: all 0.15s;
    display: block;
    pointer-events: all;
    position: relative;
    z-index: 2147483647;
  }
  .pw-opt:hover { border-color: #2d6a4f; background: #f0f7f3; }
  .pw-opt.selected { background: #2d6a4f; color: white; border-color: #2d6a4f; }

  /* Recommendation box */
  #pw-recommendation-box {
    background: #f5f0dc;
    border-left: 4px solid #2d6a4f;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }
  #pw-recommendation-box h4 { margin: 0 0 6px; font-size: 14px; color: #2d6a4f; font-weight: 700; }
  #pw-recommendation-box p { margin: 0; font-size: 12px; color: #444; line-height: 1.6; }
  #pw-recommendation-box .pw-rec-why { font-size: 12px; color: #666; margin-top: 6px; font-style: italic; }

  /* Intent buttons */
  .pw-intent-btn {
    width: 100%;
    background: white;
    border: 2px solid #e5e7eb;
    color: #1a1a1a;
    padding: 12px 16px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
    text-align: left;
    transition: all 0.15s;
    display: block;
  }
  .pw-intent-btn:hover { border-color: #2d6a4f; background: #f0f7f3; }

  /* CTA button */
  .pw-cta-btn {
    display: block;
    background: linear-gradient(135deg, #2d6a4f, #3d8b6f);
    color: white !important;
    text-decoration: none !important;
    padding: 14px 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    transition: transform 0.15s, box-shadow 0.15s;
    border: none;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 8px;
  }
  .pw-cta-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(45,106,79,0.35); }

  /* Secondary button */
  .pw-secondary-btn {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    color: #888;
    font-size: 12px;
    cursor: pointer;
    padding: 8px;
    text-align: center;
  }
  .pw-secondary-btn:hover { color: #444; }

  /* Form fields */
  .pw-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
  .pw-field label { font-size: 12px; font-weight: 600; color: #333; }
  .pw-field input { padding: 11px 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 13px; font-family: inherit; }
  .pw-field input:focus { outline: none; border-color: #2d6a4f; }
  .pw-err { font-size: 11px; color: #dc2626; display: none; }
  .pw-err.show { display: block; }

  .pw-submit-btn {
    width: 100%;
    background: linear-gradient(135deg, #2d6a4f, #3d8b6f);
    color: white;
    border: none;
    padding: 13px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    margin-bottom: 4px;
  }
  .pw-submit-btn:hover { opacity: 0.92; }

  /* Mobile */
  @media (max-width: 440px) {
    #pw-main { bottom: 0; right: 0; left: 0; width: 100%; border-radius: 16px 16px 0 0; }
    #pw-bubble { bottom: 16px; right: 16px; }
  }
</style>

<script>
  var pwData = {};
  var pwProduct = null;
  var pwArticle = document.title;
  var pwShown = false;

  var PRODUCTS = {
    jackery: {
      name: 'Jackery Explorer 1000 V2',
      specs: '1,070Wh • 2,000W output • 8-10hr runtime',
      price: '~$700',
      amazon: 'https://amzn.to/47Esd8d',
      article: '/blog/jackery-explorer-1000-v2-review/'
    },
    ecoflow: {
      name: 'EcoFlow DELTA 3 Plus',
      specs: '1,024Wh • 1,800W output • Fast charge in 1hr',
      price: '~$800',
      amazon: 'https://amzn.to/41D10iO',
      article: '/blog/ecoflow-delta-3-plus-review/'
    },
    bluetti: {
      name: 'Bluetti AC200L',
      specs: '2,048Wh • 2,400W output • 12+ hr runtime',
      price: '~$1,400',
      amazon: 'https://amzn.to/4sFpOCG',
      article: '/blog/bluetti-ac200l-review/'
    }
  };

  var QUESTIONS = [
    {
      id: 'need',
      title: 'What do you need to power?',
      hint: 'This helps us match you to the right capacity generator.',
      options: [
        { text: '🥶 Fridge only — keep food safe', value: 'fridge' },
        { text: '❄️ Fridge + chest freezer', value: 'both' },
        { text: '🏠 Multiple appliances (lights, devices, CPAP...)', value: 'multiple' }
      ]
    },
    {
      id: 'duration',
      title: 'How long do outages last in your area?',
      hint: 'Longer outages need bigger batteries. Be honest — it matters!',
      options: [
        { text: '⚡ A few hours — back up same day', value: 'short' },
        { text: '🕐 1-2 days — common storms', value: 'medium' },
        { text: '⏰ 2+ days — rural or severe weather area', value: 'long' }
      ]
    },
    {
      id: 'budget',
      title: "What's your budget range?",
      hint: 'We only recommend generators we\'ve personally tested.',
      options: [
        { text: '💰 Under $800 — value focused', value: 'low' },
        { text: '💵 $800–$1,200 — best performance', value: 'mid' },
        { text: '💸 $1,200+ — maximum capacity', value: 'high' }
      ]
    }
  ];

  var currentQ = 0;

  function pwGetRecommendation() {
    var need = pwData['need'];
    var duration = pwData['duration'];
    var budget = pwData['budget'];

    if (need === 'multiple' || duration === 'long' || budget === 'high') {
      return { product: PRODUCTS.bluetti, why: 'Your needs require maximum capacity. The Bluetti AC200L handles heavy loads and long outages with ease.' };
    } else if (budget === 'low' || duration === 'short') {
      return { product: PRODUCTS.jackery, why: 'For your use case, the Jackery 1000 V2 is the best value — reliable, quiet, and easy to use.' };
    } else {
      return { product: PRODUCTS.ecoflow, why: 'The EcoFlow DELTA 3 Plus charges the fastest (1hr!) and handles surge loads better than anything in its class.' };
    }
  }

  function pwRenderQuestion() {
    if (currentQ >= QUESTIONS.length) {
      pwShowResult();
      return;
    }
    var q = QUESTIONS[currentQ];
    var pct = ((currentQ + 1) / QUESTIONS.length * 100);
    document.getElementById('pw-progress-bar').style.width = pct + '%';
    document.getElementById('pw-progress-label').textContent = 'Step ' + (currentQ + 1) + ' of ' + QUESTIONS.length;

    var html = '<div class="pw-question-title">' + q.title + '</div>';
    html += '<div class="pw-question-hint">' + q.hint + '</div>';
    for (var i = 0; i < q.options.length; i++) {
      var opt = q.options[i];
      html += '<button class="pw-opt" onclick="pwAnswer(\'' + q.id + '\',\'' + opt.value + '\',this)">' + opt.text + '</button>';
    }
    document.getElementById('pw-question-box').innerHTML = html;
  }

  function pwAnswer(qid, val, btn) {
    var btns = document.querySelectorAll('.pw-opt');
    for (var i = 0; i < btns.length; i++) btns[i].classList.remove('selected');
    btn.classList.add('selected');
    pwData[qid] = val;
    currentQ++;
    setTimeout(pwRenderQuestion, 280);
  }

  function pwShowResult() {
    var rec = pwGetRecommendation();
    pwProduct = rec.product;

    document.getElementById('pw-step-quiz').style.display = 'none';
    document.getElementById('pw-step-result').style.display = 'block';

    document.getElementById('pw-recommendation-box').innerHTML =
      '<h4>✅ Our pick for you: ' + pwProduct.name + '</h4>' +
      '<p>' + pwProduct.specs + ' &nbsp;·&nbsp; <strong>' + pwProduct.price + '</strong></p>' +
      '<p class="pw-rec-why">' + rec.why + '</p>';

    pwShowIntent();
  }

  function pwShowIntent() {
    document.getElementById('pw-intent-box').style.display = 'block';
    document.getElementById('pw-buy-box').style.display = 'none';
    document.getElementById('pw-learn-box').style.display = 'none';
    document.getElementById('pw-email-box').style.display = 'none';
  }

  function pwShowBuyNow() {
    document.getElementById('pw-intent-box').style.display = 'none';
    document.getElementById('pw-buy-box').style.display = 'block';
    document.getElementById('pw-buy-link').href = pwProduct.amazon;
    document.getElementById('pw-buy-link').textContent = 'Buy ' + pwProduct.name + ' on Amazon →';
  }

  function pwShowLearnMore() {
    document.getElementById('pw-intent-box').style.display = 'none';
    document.getElementById('pw-learn-box').style.display = 'block';
    document.getElementById('pw-article-link').href = pwProduct.article;
    document.getElementById('pw-article-link').textContent = 'Read Full ' + pwProduct.name + ' Review →';
  }

  function pwShowGuide() {
    document.getElementById('pw-intent-box').style.display = 'none';
    document.getElementById('pw-email-box').style.display = 'block';
  }

  function pwSubmitEmail() {
    var name = document.getElementById('pw-name').value.trim();
    var email = document.getElementById('pw-email').value.trim();
    var nameErr = document.getElementById('pw-name-err');
    var emailErr = document.getElementById('pw-email-err');

    nameErr.classList.remove('show');
    emailErr.classList.remove('show');

    if (!name) { nameErr.textContent = 'Please enter your name'; nameErr.classList.add('show'); return; }
    if (!email || email.indexOf('@') < 0) { emailErr.textContent = 'Please enter a valid email'; emailErr.classList.add('show'); return; }

    fetch('https://api.kit.com/v4/forms/9163556/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email_address: email, fields: { first_name: name, source_article: pwArticle, recommended_product: pwProduct.name } })
    }).catch(function(e) { console.log('Kit:', e); });

    var leads = JSON.parse(localStorage.getItem('pwLeads') || '[]');
    leads.push({ name: name, email: email, article: pwArticle, product: pwProduct.name, ts: new Date().toISOString() });
    localStorage.setItem('pwLeads', JSON.stringify(leads));

    document.getElementById('pw-step-result').style.display = 'none';
    document.getElementById('pw-step-success').style.display = 'block';
    document.getElementById('pw-success-product').textContent = 'Your guide covers: ' + pwProduct.name;
    localStorage.setItem('pwDone', '1');
  }

  function pwMinimize() {
    document.getElementById('pw-main').style.display = 'none';
    var bubble = document.getElementById('pw-bubble');
    bubble.style.display = 'flex';
    localStorage.setItem('pwMinimized', '1');
  }

  function pwRestore() {
    document.getElementById('pw-main').style.display = 'block';
    document.getElementById('pw-bubble').style.display = 'none';
    localStorage.removeItem('pwMinimized');
  }

  function pwClose() {
    document.getElementById('pw-main').style.display = 'none';
    document.getElementById('pw-bubble').style.display = 'none';
  }

  function pwInit() {
    var h1 = document.querySelector('h1');
    if (h1) pwArticle = h1.textContent.trim();

    if (localStorage.getItem('pwDone')) return;

    if (localStorage.getItem('pwMinimized')) {
      document.getElementById('pw-bubble').style.display = 'flex';
      return;
    }

    setTimeout(function() {
      document.getElementById('pw-main').style.display = 'block';
      pwRenderQuestion();
    }, 30000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pwInit);
  } else {
    pwInit();
  }
</script>
