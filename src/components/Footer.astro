---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Eco Living Journey. All rights reserved.</p>
	<p class="tagline" style="color: #4b5563; font-weight: 500;">Hosted by Ethan</p>
	
	<nav style="display: flex; gap: 15px; justify-content: center; margin-top: 10px;">
    <a href="/privacy">Privacy Policy</a>
    <a href="/disclosure">Affiliate Disclosure</a>
    <a href="/about">About Ethan</a>
</nav>

	<div style="margin-top: 15px; font-size: 0.8rem; color: #9ca3af;">
		<a href="/sitemap-index.xml" style="color: #9ca3af;">Sitemap</a>
	</div>
</footer>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Eco Living Journey",
  "url": "https://ecoliving-journey.com",
  "logo": "https://ecoliving-journey.com/logo.webp",
  "description": "Independent reviews and testing of solar generators and home backup power systems.",
  "founder": {
    "@type": "Person",
    "name": "Ethan Reynolds"
  },
  "sameAs": [
    "https://www.reddit.com/user/EcoLivingEthan"
  ]
}
</script>

<style>
	footer {
		padding: 3em 1em;
		background: #f8fafc;
		color: #4a5568;
		text-align: center;
		margin-top: 4em;
		border-top: 1px solid #e2e8f0;
	}
	p {
		margin: 0.5em 0;
		font-weight: 500;
	}
	.tagline {
		font-size: 0.9em;
		color: #718096;
		margin-bottom: 1.5em;
		font-style: italic;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
	}
	.social-links a {
		text-decoration: none;
		color: #4a5568;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.social-links a:hover {
		color: #2f855a; /* Changes to your Nature Green on hover */
		transform: translateY(-2px); /* Slight bounce effect */
	}
</style>