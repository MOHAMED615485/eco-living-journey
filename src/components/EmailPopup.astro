<style>
@keyframes popIn {
  from { opacity:0; transform:scale(0.92) translateY(20px); }
  to { opacity:1; transform:scale(1) translateY(0); }
}
#elj-popup-overlay.show { display:flex !important; }
</style>

<script is:inline>
(function() {
  var COOKIE_KEY = 'elj_popup_shown';
  var DAYS = 7;

  function getCookie(name) {
    var v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
    return v ? v[2] : null;
  }
  function setCookie(name, value, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/';
  }

  function showPopup() {
    if (getCookie(COOKIE_KEY)) return;
    var overlay = document.getElementById('elj-popup-overlay');
    if (overlay) overlay.classList.add('show');
  }

  function hidePopup() {
    var overlay = document.getElementById('elj-popup-overlay');
    if (overlay) overlay.classList.remove('show');
    setCookie(COOKIE_KEY, '1', DAYS);
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (getCookie(COOKIE_KEY)) return;

    // Timer trigger - 40 seconds
    var timer = setTimeout(showPopup, 40000);

    // Scroll trigger - 50%
    function onScroll() {
      var scrolled = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (scrolled >= 0.5) {
        clearTimeout(timer);
        showPopup();
        window.removeEventListener('scroll', onScroll);
      }
    }
    window.addEventListener('scroll', onScroll);

    // Close button
    var closeBtn = document.getElementById('elj-popup-close');
    if (closeBtn) closeBtn.addEventListener('click', hidePopup);

    // Click outside
    var overlay = document.getElementById('elj-popup-overlay');
    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) hidePopup();
      });
    }

    // ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hidePopup();
    });

    // Form submit
    var form = document.getElementById('elj-popup-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = form.querySelector('input[type="email"]').value;
        var formData = new FormData();
        formData.append('email_address', email);
        fetch('https://app.kit.com/forms/9163556/subscriptions', {
          method: 'POST',
          body: formData,
          mode: 'no-cors'
        }).then(function() {
          var box = document.getElementById('elj-popup-box');
          if (box) box.innerHTML = '<div style="padding:3rem 2rem;text-align:center;"><div style="font-size:3rem;margin-bottom:1rem;">✅</div><h3 style="color:#2d6a4f;font-family:Georgia,serif;font-size:1.3rem;margin:0 0 0.5rem;">You\'re in!</h3><p style="color:#718096;font-family:Georgia,serif;font-size:0.9rem;margin:0 0 1.5rem;">Check your inbox for ethan@ecoliving-journey.com — your checklist is on its way.</p><button onclick="document.getElementById(\'elj-popup-overlay\').classList.remove(\'show\')" style="background:#2d6a4f;color:#fff;border:none;padding:10px 28px;border-radius:50px;font-size:0.9rem;cursor:pointer;font-family:Georgia,serif;">Got it!</button></div>';
          setCookie(COOKIE_KEY, '1', 30);
        });
      });
    }
  });
})();
</script>
