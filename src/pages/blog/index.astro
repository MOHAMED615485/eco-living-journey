---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).filter((post: any) => post.data.title && post.data.heroImage);

const categories = {
  "Solar Generator Reviews": [
    "ecoflow-delta-3-plus-review",
    "jackery-explorer-1000-v2-review",
    "bluetti-ac200l-review",
    "ecoflow-vs-jackery-comparison",
    "ecoflow-vs-bluetti",
  ],
  "Best Solar Generators": [
    "best-solar-generator-home-backup-2026",
    "best-solar-generator-under-1000",
    "best-solar-generator-chest-freezer-2026",
    "best-solar-generator-well-pump",
    "best-solar-generator-cpap-machine",
    "best-solar-camping-2026",
    "best-solar-generator-camping-2026",
  ],
  "Power Outage Prep": [
    "how-to-prep-home-power-outage",
    "how-long-do-power-outages-last",
    "how-long-food-lasts-without-power",
    "best-emergency-kit-power-outage-2026",
    "chest-freezer-blackout-math",
  ],
  "Solar Generator Guides": [
    "surge-vs-running-watts",
    "what-appliances-can-solar-generator-run",
    "will-1000w-solar-generator-run-refrigerator",
    "can-solar-generator-power-window-ac",
    "how-long-does-solar-generator-last",
    "store-solar-generator-winter",
    "lifepo4-vs-lithium-ion",
    "portable-power-station-vs-gas-generator",
    "how-many-watts-chest-freezer",
    "what-is-lra-on-a-freezer",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={"Blog — Eco Living Journey"} description={"Real-world solar generator tests, home backup power guides, and emergency prep by Ethan Reynolds — 73-day field tester."} />
    <style>
      :root {
        --green-dark: #2d6a4f;
        --green-btn: #3d8b6f;
        --cream: #f5f0dc;
        --text-dark: #1a202c;
        --text-muted: #718096;
        --card-shadow: 0 2px 12px rgba(45,106,79,0.08);
        --card-hover: 0 8px 30px rgba(45,106,79,0.18);
      }

      * { box-sizing: border-box; }

      body {
        background: var(--cream);
        font-family: Georgia, serif;
        color: var(--text-dark);
        margin: 0;
      }

      .blog-hero {
        background: var(--green-dark);
        padding: 3rem 1rem 2rem;
        text-align: center;
      }

      .blog-hero h1 {
        color: #fff;
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0 0 0.5rem;
        font-family: Georgia, serif;
      }

      .blog-hero p {
        color: rgba(255,255,255,0.75);
        font-size: 1rem;
        margin: 0 0 1.5rem;
      }

      .search-wrap {
        max-width: 560px;
        margin: 0 auto;
        position: relative;
      }

      .search-wrap input {
        width: 100%;
        padding: 14px 50px 14px 20px;
        border-radius: 50px;
        border: none;
        font-size: 1rem;
        outline: none;
        background: #fff;
        color: var(--text-dark);
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        font-family: Georgia, serif;
      }

      .search-wrap input::placeholder { color: #aaa; }

      .search-icon {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--green-dark);
        font-size: 1.2rem;
        pointer-events: none;
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1rem 4rem;
      }

      .no-results {
        display: none;
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
        font-size: 1.1rem;
      }

      .category-section {
        margin-bottom: 3.5rem;
      }

      .category-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--green-dark);
      }

      .category-header h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--green-dark);
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-family: Georgia, serif;
      }

      .category-count {
        background: var(--green-dark);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 50px;
        font-family: Georgia, serif;
      }

      .cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--card-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        display: block;
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--card-hover);
      }

      .card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        display: block;
      }

      .card-body {
        padding: 1rem 1.1rem 1.2rem;
      }

      .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1.4;
        margin: 0 0 0.5rem;
        font-family: Georgia, serif;
        transition: color 0.2s;
      }

      .card:hover .card-title {
        color: var(--green-dark);
      }

      .card-date {
        font-size: 0.78rem;
        color: var(--text-muted);
        margin: 0;
        font-family: Georgia, serif;
      }

      .search-results-section {
        display: none;
        margin-bottom: 3rem;
      }

      .search-results-section.active {
        display: block;
      }

      .search-results-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--green-btn);
      }

      .search-results-header h2 {
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--green-btn);
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-family: Georgia, serif;
      }

      @media (max-width: 768px) {
        .cards-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 1rem;
        }
        .blog-hero h1 { font-size: 1.6rem; }
        .card img { height: 130px; }
      }

      @media (max-width: 480px) {
        .cards-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
    <script is:inline data-grow-initializer="">!(function(){window.addEventListener('load',function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");(e.type="text/javascript"),(e.src="https://faves.grow.me/main.js"),(e.defer=!0),e.setAttribute("data-grow-faves-site-id","U2l0ZTo1ZmZlMDAzMS1jMTliLTRkNDktOWVlYy1jYTA1YWRmNjAyNTU=");var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);});})();</script>
  </head>
  <body>
    <Header />

    <div class="blog-hero">
      <h1>Solar Generator &amp; Power Outage Guides</h1>
      <p>73-day real-world tests by Ethan Reynolds — no sponsored fluff, just honest results</p>
      <div class="search-wrap">
        <input type="text" id="searchInput" placeholder="Search articles... (e.g. EcoFlow, freezer, outage)" autocomplete="off" />
        <span class="search-icon">&#128269;</span>
      </div>
    </div>

    <main>
      <div class="no-results" id="noResults">No articles found. Try a different search term.</div>

      <div class="search-results-section" id="searchResults">
        <div class="search-results-header">
          <h2>Search Results</h2>
          <span class="category-count" id="searchCount">0</span>
        </div>
        <div class="cards-grid" id="searchGrid"></div>
      </div>

      {Object.entries(categories).map(([catName, slugs]) => {
        const catPosts = slugs
          .map(slug => allPosts.find((p: any) => (p.slug || p.id) === slug))
          .filter(Boolean);
        if (catPosts.length === 0) return null;
        return (
          <div class="category-section" data-category={catName}>
            <div class="category-header">
              <h2>{catName}</h2>
              <span class="category-count">{catPosts.length}</span>
            </div>
            <div class="cards-grid">
              {catPosts.map((post: any) => (
                <a class="card" href={"/blog/" + (post.slug || post.id) + "/"} data-title={post.data.title.toLowerCase()} data-category={catName.toLowerCase()}>
                  <img
                    src={post.data.heroImage?.src || post.data.heroImage}
                    alt={post.data.title}
                    loading="lazy"
                    width={400}
                    height={160}
                  />
                  <div class="card-body">
                    <p class="card-title">{post.data.title}</p>
                    <p class="card-date"><FormattedDate date={post.data.pubDate} /></p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </main>

    <Footer />

    <script is:inline>
      var searchInput = document.getElementById('searchInput');
      var searchResults = document.getElementById('searchResults');
      var searchGrid = document.getElementById('searchGrid');
      var searchCount = document.getElementById('searchCount');
      var noResults = document.getElementById('noResults');
      var categorySections = document.querySelectorAll('.category-section');
      var allCards = document.querySelectorAll('.card');

      searchInput.addEventListener('input', function() {
        var query = this.value.toLowerCase().trim();

        if (query === '') {
          searchResults.classList.remove('active');
          noResults.style.display = 'none';
          categorySections.forEach(function(s) { s.style.display = ''; });
          return;
        }

        categorySections.forEach(function(s) { s.style.display = 'none'; });

        var matched = [];
        allCards.forEach(function(card) {
          var title = card.getAttribute('data-title') || '';
          var category = card.getAttribute('data-category') || '';
          if (title.includes(query) || category.includes(query)) {
            matched.push(card.cloneNode(true));
          }
        });

        searchGrid.innerHTML = '';
        matched.forEach(function(card) { searchGrid.appendChild(card); });
        searchCount.textContent = matched.length;

        if (matched.length > 0) {
          searchResults.classList.add('active');
          noResults.style.display = 'none';
        } else {
          searchResults.classList.remove('active');
          noResults.style.display = 'block';
        }
      });
    </script>
  </body>
</html>
