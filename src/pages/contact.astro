---
import Layout from '../layouts/BlogPost.astro';

const title = "Contact Ethan — Eco Living Journey";
const description = "Have a question about solar generators or home backup power? Get in touch with Ethan at Eco Living Journey.";
---

<Layout title={title} description={description} pubDate={new Date('February 26 2026')}>

<style>
  /* This page has no affiliate links - hide the disclosure inherited from BlogPost layout */
  .prose > p[style*="affiliate links"] { display: none !important; }
</style>


<div style="max-width:640px;margin:0 auto;padding:40px 20px;">

  <h1 style="font-size:2rem;font-weight:700;color:#2d6a4f;margin-bottom:8px;">Get in Touch</h1>
  <p style="font-size:1.1rem;color:#555;margin-bottom:32px;">Have a question about solar generators, backup power, or anything on the site? Ethan reads every message personally.</p>

  <div style="background:#f0faf4;border-left:4px solid #2d6a4f;border-radius:8px;padding:24px;margin-bottom:32px;">
    <p style="font-size:1rem;color:#2d4a3e;margin:0 0 8px;font-weight:600;">📬 Email Ethan directly</p>
    <a href="mailto:ethan@ecoliving-journey.com" style="font-size:1.1rem;color:#2d6a4f;font-weight:700;text-decoration:none;">ethan@ecoliving-journey.com</a>
    <p style="font-size:0.9rem;color:#666;margin:8px 0 0;">Typical response time: 24–48 hours</p>
  </div>

  <div style="background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:24px;margin-bottom:32px;">
    <h2 style="font-size:1.2rem;font-weight:600;color:#2d6a4f;margin-bottom:16px;">What Ethan can help with</h2>
    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
      <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:#2d6a4f;font-weight:700;">→</span><span style="color:#444;">Sizing a solar generator for your specific appliances</span></li>
      <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:#2d6a4f;font-weight:700;">→</span><span style="color:#444;">Comparing EcoFlow, Jackery, and Bluetti models</span></li>
      <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:#2d6a4f;font-weight:700;">→</span><span style="color:#444;">Understanding surge watts and LRA ratings</span></li>
      <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:#2d6a4f;font-weight:700;">→</span><span style="color:#444;">Setting up backup power for a well pump or chest freezer</span></li>
      <li style="display:flex;gap:10px;align-items:flex-start;"><span style="color:#2d6a4f;font-weight:700;">→</span><span style="color:#444;">General questions about home backup power</span></li>
    </ul>
  </div>

  <div style="background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:24px;margin-bottom:32px;">
    <h2 style="font-size:1.2rem;font-weight:600;color:#2d6a4f;margin-bottom:16px;">Media and partnerships</h2>
    <p style="color:#555;margin:0 0 12px;">For affiliate partnership inquiries, product review requests, or media questions — email Ethan directly at <a href="mailto:ethan@ecoliving-journey.com" style="color:#2d6a4f;font-weight:600;">ethan@ecoliving-journey.com</a> with the subject line "Partnership Inquiry."</p>
    <p style="color:#777;font-size:0.9rem;margin:0;">Please note: Ethan only reviews products he has personally tested or researched extensively. Sponsored content is always disclosed.</p>
  </div>

  <div style="background:#f0faf4;border-radius:12px;padding:20px;text-align:center;">
    <p style="color:#2d4a3e;font-size:0.95rem;margin:0 0 12px;">Looking for quick answers? Try these first:</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;">
      <a href="/solar-calculator/" style="background:#2d6a4f;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:600;">🧮 Solar Calculator</a>
      <a href="/blog/best-solar-generator-home-backup-2026/" style="background:#2d6a4f;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:600;">⚡ Best Generators</a>
      <a href="/blog/what-appliances-can-solar-generator-run/" style="background:#2d6a4f;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.9rem;font-weight:600;">🔌 Appliance Guide</a>
    </div>
  </div>

</div>
</Layout>
