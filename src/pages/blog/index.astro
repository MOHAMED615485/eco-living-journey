---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [
	'All',
	'Solar Generator Reviews',
	'Best Solar Generators',
	'Solar Generators',
	'Solar Generator Guides',
	'Power Outage Guides',
	'Power Outage Prep',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			/* ── Layout ── */
			main {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 3em 1.5em;
			}

			.blog-header {
				text-align: center;
				margin-bottom: 2.5rem;
			}

			.blog-header h1 {
				font-size: 2.8rem;
				font-weight: 900;
				color: #1a202c;
				margin: 0 0 0.5rem;
			}

			.blog-header p {
				color: #718096;
				font-size: 1.15rem;
				margin: 0;
			}

			/* ── Category Filter Tabs ── */
			.category-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				justify-content: center;
				margin-bottom: 2rem;
				padding: 0 0.5rem;
			}
			@media (max-width: 720px) {
				.category-tabs {
					gap: 0.4rem;
				}
				.cat-btn {
					padding: 0.4rem 0.9rem;
					font-size: 0.8rem;
				}
			}

			.cat-btn {
				padding: 0.5rem 1.2rem;
				border-radius: 999px;
				border: 2px solid #e2e8f0;
				background: #fff;
				color: #4a5568;
				font-size: 0.9rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.cat-btn:hover,
			.cat-btn.active {
				background: #2f855a;
				border-color: #2f855a;
				color: #fff;
			}

			/* ── Grid ── */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-card {
				background: #fff;
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 2px 12px rgba(0,0,0,0.07);
				transition: transform 0.25s ease, box-shadow 0.25s ease;
			}

			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 28px rgba(47,133,90,0.15);
			}

			.post-card a {
				text-decoration: none;
				display: block;
				color: inherit;
			}

			.post-card img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				display: block;
			}

			.post-card-body {
				padding: 1.2rem 1.4rem 1.4rem;
			}

			.post-category-tag {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #2f855a;
				background: #f0fff4;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				margin-bottom: 0.6rem;
			}

			.post-title {
				font-size: 1.1rem;
				font-weight: 800;
				color: #1a202c;
				line-height: 1.35;
				margin: 0 0 0.5rem;
			}

			.post-date {
				font-size: 0.85rem;
				color: #a0aec0;
				margin: 0;
			}

			.post-card.hidden {
				display: none;
			}

			/* ── No results ── */
			.no-results {
				text-align: center;
				color: #a0aec0;
				font-size: 1.1rem;
				padding: 3rem 0;
				display: none;
			}

			/* ── Responsive ── */
			@media (max-width: 720px) {
				.blog-header h1 {
					font-size: 2rem;
				}
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
		<script is:inline data-grow-initializer="">!(function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");(e.type="text/javascript"),(e.src="https://faves.grow.me/main.js"),(e.defer=!0),e.setAttribute("data-grow-faves-site-id","U2l0ZTo1ZmZlMDAzMS1jMTliLTRkNDktOWVlYy1jYTA1YWRmNjAyNTU=");var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);})();</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<h1>Solar Generator Reviews & Guides</h1>
				<p>73-day field tests, real watt numbers, honest recommendations.</p>
			</div>

			<div class="category-tabs">
				{categories.map((cat) => (
					<button
						class={`cat-btn${cat === 'All' ? ' active' : ''}`}
						data-category={cat}
					>
						{cat}
					</button>
				))}
			</div>

			<ul class="posts-grid" id="posts-grid">
				{posts.map((post: any) => (
					<li
						class="post-card"
						data-category={post.data.category || 'Uncategorized'}
					>
						<a href={`/blog/${post.slug || post.id}/`}>
							<img
								width={600}
								height={200}
								src={post.data.heroImage?.src || post.data.heroImage}
								alt={post.data.title}
								loading="lazy"
							/>
							<div class="post-card-body">
								{post.data.category && (
									<span class="post-category-tag">{post.data.category}</span>
								)}
								<h4 class="post-title">{post.data.title}</h4>
								<p class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>

			<p class="no-results" id="no-results">No articles found in this category.</p>
		</main>
		<Footer />

		<script is:inline>
			const buttons = document.querySelectorAll('.cat-btn');
			const cards = document.querySelectorAll('.post-card');
			const noResults = document.getElementById('no-results');

			buttons.forEach(function(btn) {
				btn.addEventListener('click', function() {
					const selected = btn.getAttribute('data-category');

					buttons.forEach(function(b) { b.classList.remove('active'); });
					btn.classList.add('active');

					let visible = 0;
					cards.forEach(function(card) {
						const cardCat = card.getAttribute('data-category');
						if (selected === 'All' || cardCat === selected) {
							card.classList.remove('hidden');
							visible++;
						} else {
							card.classList.add('hidden');
						}
					});

					noResults.style.display = visible === 0 ? 'block' : 'none';
				});
			});
		</script>
	</body>
</html>
